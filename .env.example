# Copy this file to .env.local and fill it in. .env.local is git-ignored: never commit real keys.
# On your host (for example Vercel → Project → Settings → Environment Variables) add the same names.
# Everything is optional: with none of it the app still works, using scripted coach lines.

# ---- AI coach: Auntie reacts to your check-in note and answers questions on the Learn screen ----
# Any OpenAI-compatible chat API works (OpenAI, Groq, OpenRouter, Together, Gemini's OpenAI endpoint...).
LLM_API_KEY=
LLM_MODEL=
# Defaults to https://api.openai.com/v1
# LLM_BASE_URL=https://api.openai.com/v1
# Some newer models need this instead of max_tokens:
# LLM_TOKEN_PARAM=max_completion_tokens

# ---- Coach voice (ElevenLabs) ----
# Speaks the AI coach's replies, and lets `npm run audio:coach` pre-record her scripted lines.
# Voice IDs are in ElevenLabs → Voices (the "ID" on a voice's menu). A voice from the shared Voice
# Library needs a paid ElevenLabs plan to use through the API.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Leave blank for ElevenLabs' default model, or set one, e.g. a faster, cheaper "flash" model.
# ELEVENLABS_MODEL=
# Optional. 0.7 to 1.2, default 1
# ELEVENLABS_SPEED=1
